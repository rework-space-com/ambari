{% endif %}

{% if hive_enabled %}
[INPUT]
    Name              tail
    Tag               hadoop.hive
    Path              /var/log/hive/*.log
    DB                /var/lib/fluent-bit/hive.db
    Read_from_Head    false
    Skip_Long_Lines   On
    Refresh_Interval  10
{% endif %}

{% if spark_enabled %}
[INPUT]
    Name              tail
    Tag               hadoop.spark
    Path              /var/log/spark/*.log
    DB                /var/lib/fluent-bit/spark.db
    Read_from_Head    false
    Skip_Long_Lines   On
