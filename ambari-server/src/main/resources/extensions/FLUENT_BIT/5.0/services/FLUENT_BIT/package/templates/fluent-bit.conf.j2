[OUTPUT]
    Name                 opensearch
    Match                *
    Host                 {{ opensearch_host }}
    Port                 {{ opensearch_port }}
    Index                hadoop-logs
    Logstash_Format      On
    Logstash_Prefix      hadoop-logs
    Suppress_Type_Name   On
    Retry_Limit          5
