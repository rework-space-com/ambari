[SERVICE]
    Flush        {{ fluent_bit_flush }}
    Log_Level    {{ fluent_bit_log_level }}
    Parsers_File /etc/fluent-bit/parsers.conf
    storage.path /var/lib/fluent-bit/storage

{% if hdfs_enabled %}
[INPUT]
    Name              tail
    Tag               hadoop.hdfs
    Path              /var/log/hadoop-hdfs/*.log
    DB                /var/lib/fluent-bit/hadoop-hdfs.db
    Read_from_Head    false
    Skip_Long_Lines   On
    Refresh_Interval  10
{% endif %}

{% if yarn_enabled %}
[INPUT]
    Name              tail
    Tag               hadoop.yarn
    Path              /var/log/hadoop-yarn/*.log
    DB                /var/lib/fluent-bit/hadoop-yarn.db
    Read_from_Head    false
    Skip_Long_Lines   On
    Refresh_Interval  10
{% endif %}

{% if ambari_server_enabled %}
[INPUT]
    Name              tail
    Tag               ambari.server
    Path              /var/log/ambari-server/*.log
    DB                /var/lib/fluent-bit/ambari-server.db
    Read_from_Head    false
    Skip_Long_Lines   On
    Refresh_Interval  10
{% endif %}

{% if ambari_agent_enabled %}
[INPUT]
    Name              tail
    Tag               ambari.agent
